# Required
BOT_TOKEN=123456:YOUR_BOT_TOKEN
DATABASE_URL=postgresql://user:password@host:5432/database

# Set this to your final Blitz HTTPS address, for example:
# WEBAPP_URL=https://isk.sjkstr.blitz.cloud
WEBAPP_URL=https://YOUR-APP.YOUR-ADDRESS.blitz.cloud

# Optional
ADMIN_IDS=
CORS_ORIGINS=*
LOG_LEVEL=INFO

SHERLOCK_DAILY_LIMIT_FREE=5
SHERLOCK_DAILY_LIMIT_PRO=100
SHERLOCK_DAILY_LIMIT_ULTRA=500

# Redis is not required by the Blitz MVP and can be left empty.
REDIS_URL=
